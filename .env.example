# Optional — Groq API key can be managed from the dashboard instead.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,meta-llama/llama-4-scout-17b-16e-instruct
SUMMARY_MAX_CHARACTERS=1800

# Discord webhooks and per-route polling are configured in the dashboard.
# Legacy DISCORD_WEBHOOK_URL / DISCORD_WEBHOOK_ID / POLL_INTERVAL_MINUTES are no longer read.

TOP_TEST_ARTICLE_COUNT=2
TOP_TEST_REFERENCE_URL=
LOG_LEVEL=info
LOG_FORMAT=pretty
SQLITE_PATH=./data/news-crawling.sqlite

# Dashboard server
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=3000
